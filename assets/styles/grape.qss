QWidget#explorerContainer {
    background-color: #fff;
    border-radius: 8px;
    padding: 2px;
}
QWidget#centralWindow {
    background-color: #171f14;
}
QWidget#canvasArea {
    background-color: #1e2b1a;
    border: 1px solid #263720;
    border-radius: 8px;
}
QTreeView {
    background-color: #1e2b1a;
    border-radius: 8px;
    border-color: #263720;
    border-style: solid;
    border-width: 1px;
    /* padding */
    padding: 4px;
}
QTreeView::item:selected {
    outline: 0px;
    background-color: #807641;
    border-radius: 4px;
}
