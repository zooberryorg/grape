QWidget#explorerContainer {
    background-color: #1e2b1a;
    border-radius: 8px;
    border-color: #263720;
    border-style: solid;
    border-width: 1px;
    /* padding */
    padding: 4px;
}
QWidget#centralWindow {
    background-color: #171f14;
}
QWidget#canvasArea {
    background-color: #1e2b1a;
    border: 1px solid #263720;
    border-radius: 8px;
}
QWidget#propertyPanel {
    background-color: #263621;
    border-left: 0px;
    border-top: 1px solid #263720;
    border-right: 1px solid #263720;
    border-bottom: 1px solid #263720;
    border-top-left-radius: 0px;
    border-bottom-left-radius: 0px;
    border-top-right-radius: 8px;
    border-bottom-right-radius: 8px;
    padding: 10px;
}
QWidget#propertyPanelGroup {
    background-color: #171f14;
    border: 1px solid #263720;
    border-radius: 8px;
}
QWidget#toolbarButton {
    background-color: #171f14;
    border: 1px solid #171f14;
    border-top-left-radius: 8px;
    border-bottom-left-radius: 8px;
    border-top-right-radius: 0px;
    border-bottom-right-radius: 0px;
    border-top: 1px solid #171f14;
    border-right: 0px;
    border-bottom: 1px solid #171f14;
    border-left: 1px solid #171f14;


}
QWidget#toolbarButton:hover {
    background-color: #263621;
    border-top: 1px solid #263621;
    border-right: 0px;
    border-bottom: 1px solid #263621;
    border-left: 1px solid #263621;
    color: #807641;
}
QWidget#toolbarButton:pressed {
    background-color: #263621;
    border-top: 1px solid #263621;
    border-right: 0px;
    border-bottom: 1px solid #263621;
    border-left: 1px solid #263621;
    color: #807641;
}
QWidget#toolbarButton:checked {
    background-color: #263621;
    border-top: 1px solid #263621;
    border-right: 0px;
    border-bottom: 1px solid #263621;
    border-left: 1px solid #263621;
    color: #807641;
}

QWidget#toolbar {
    border: 1px solid #263720;
    border-top-left-radius: 8px;
    border-bottom-left-radius: 8px;
    border-top-right-radius: 0px;
    border-bottom-right-radius: 0px;

}
/* QTreeView */
QTreeView {
    background-color: #263621;
    border: 1px solid #395132;
    border-radius: 8px;
    font-size: 11px;
    padding: 4px;
    outline: none;
}
QTreeView::branch:selected {
    outline: 0px;
    background-color: #263621;
    border: none;
}
QTreeView::item:selected {
    outline: 0px;
    background-color: #807641;
    border: none;
    border-top-right-radius: 6px;
    border-bottom-right-radius: 6px;
}
/* QCheckBox */
QCheckBox {
    font-size: 11px;
}
QCheckBox::indicator {
    width: 8px;
    height: 8px;
    border: 2px solid #182315;
    border-radius: 4px;
    background-color: #182315;
}
QCheckBox::indicator:hover {
    border: 2px solid #1d2719;
    background-color: #1d2719;
}
QCheckBox::indicator:checked {
    border-color: #d5ac50;
    background-color: #d5ac50;
    image: url(:/icons/check.svg); 
}

QListView
{
    outline: none;
}
QStatusBar::item {
    border: none;
}