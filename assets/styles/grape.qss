QWidget#explorerContainer {
    background-color: #1e2b1a;
    border-radius: 8px;
    border-color: #263720;
    border-style: solid;
    border-width: 1px;
    /* padding */
    padding: 4px;
}
QWidget#centralWindow {
    background-color: #171f14;
}
QWidget#canvasArea {
    background-color: #1e2b1a;
    border: 1px solid #263720;
    border-radius: 8px;
}
QWidget#propertyPanel {
    background-color: #263621;
    border-left: 0px;
    border-top: 1px solid #263720;
    border-right: 1px solid #263720;
    border-bottom: 1px solid #263720;
    border-top-left-radius: 0px;
    border-bottom-left-radius: 0px;
    border-top-right-radius: 8px;
    border-bottom-right-radius: 8px;
    padding: 10px;
}
QWidget#propertyPanelGroup {
    background-color: #171f14;
    border: 1px solid #263720;
    border-radius: 8px;
}
QWidget#toolbarButton {
    background-color: #171f14;
    border: 1px solid #171f14;
    border-top-left-radius: 8px;
    border-bottom-left-radius: 8px;
    border-top-right-radius: 0px;
    border-bottom-right-radius: 0px;
    border-top: 1px solid #171f14;
    border-right: 0px;
    border-bottom: 1px solid #171f14;
    border-left: 1px solid #171f14;


}
QWidget#toolbarButton:hover {
    background-color: #263621;
    border-top: 1px solid #263621;
    border-right: 0px;
    border-bottom: 1px solid #263621;
    border-left: 1px solid #263621;
    color: #807641;
}
QWidget#toolbarButton:pressed {
    background-color: #263621;
    border-top: 1px solid #263621;
    border-right: 0px;
    border-bottom: 1px solid #263621;
    border-left: 1px solid #263621;
    color: #807641;
}
QWidget#toolbarButton:checked {
    background-color: #263621;
    border-top: 1px solid #263621;
    border-right: 0px;
    border-bottom: 1px solid #263621;
    border-left: 1px solid #263621;
    color: #807641;
}

QWidget#toolbar {
    border: 1px solid #263720;
    border-top-left-radius: 8px;
    border-bottom-left-radius: 8px;
    border-top-right-radius: 0px;
    border-bottom-right-radius: 0px;

}
/* QTreeView */
QTreeView {
    background-color: #263621;
    border: 1px solid #395132;
    border-radius: 8px;
    font-size: 11px;
    padding: 4px;
    outline: none;
    show-decoration-selected: 1;
}

QTreeView::item {
    padding: 4px 6px;
    border: none;
}
QTreeView::item:hover {
    background-color: #2e4226;
}
QTreeView::branch:hover {
    background-color: #2e4226;
}

QTreeView::branch:selected {
    background-color: #807641;
    border: none;
    outline: 0;
}
QTreeView::item:selected {
    background-color: #807641;
    color: #171f14;
    border: none;
    border-top-right-radius: 6px;
    border-bottom-right-radius: 6px;
}
/* QCheckBox */
QCheckBox {
    font-size: 11px;
    color: #c9c9c9;
    spacing: 6px;
}
QCheckBox::indicator {
    width: 14px;
    height: 14px;
    border: 2px solid #2e4226;
    border-radius: 3px;
    background-color: #182315;
}
QCheckBox::indicator:hover {
    border: 2px solid #395132;
    background-color: #1d2719;
}
QCheckBox::indicator:checked {
    border-color: #d5ac50;
    background-color: #d5ac50;
    image: url(:/icons/check.svg);
}
QCheckBox::indicator:checked:hover {
    border-color: #c9a961;
    background-color: #c9a961;
}
QCheckBox::indicator:disabled {
    background-color: #141d10;
    border: 2px solid #232f20;
}
QCheckBox::indicator:checked:disabled {
    background-color: #4a4030;
    border-color: #4a4030;
}

QListView
{
    outline: none;
}
QStatusBar::item {
    border: none;
}
/* QSpinBox */
QSpinBox {
    border: 2px solid #2e4226;
    border-radius: 4px;
    background-color: #182315;
    color: #c9c9c9;
    font-size: 11px;
    min-height: 24px;
}
QSpinBox:hover {
    background-color: #1d2719;
}
QSpinBox:focus {
    border: 2px solid #c9a961;
}
QSpinBox:disabled {
    background-color: #141d10;
    color: #5a6a52;
}

QSpinBox::up-button, QSpinBox::down-button {
    width: 16px;
    height: 12px;
    background-color: #24361f;
    border-left: 1px solid #24361f;
    border-right: 2px solid #2e4226;
}
QSpinBox::up-button {
    subcontrol-origin: border;
    subcontrol-position: top right;
    image: url(:/icons/arrow-up.svg);
    border-top: 2px solid #2e4226;
    border-bottom: 1px solid #24361f;
    border-top-right-radius: 4px;
}
QSpinBox::down-button {
    subcontrol-origin: border;
    subcontrol-position: bottom right;
    image: url(:/icons/arrow-down.svg);
    border-bottom: 2px solid #2e4226;
    border-bottom-right-radius: 4px;
}

QSpinBox::up-button:hover, QSpinBox::down-button:hover {
    background-color: #14361f;
}
QSpinBox::up-button:pressed, QSpinBox::down-button:pressed {
    background-color: #0f2617;
}
QSpinBox::up-button:focus, QSpinBox::down-button:focus {
    border-color: #c9a961;
}
QSpinBox::up-button:disabled, QSpinBox::down-button:disabled {
    background-color: #1b241a;
}
/* QSplitter */
QSplitter::handle {
    background-color: #171f14;
}
QSplitter::handle:hover {
    background-color: #c9a961;
}
/* QHeaderView */
QHeaderView::section {
    background-color: #1e2b1a;
    color: #8fa384;
    font-size: 11px;
    font-weight: 600;
    padding: 4px 8px;
    border: none;
    border-right: 1px solid #395132;
    border-bottom: 1px solid #395132;
}
QHeaderView::section:first {
    border-left: 1px solid #395132;
}
QHeaderView::section:hover {
    background-color: #24361f;
}

QTableCornerButton::section {
    background-color: #1e2b1a;
    border: none;
    border-right: 1px solid #395132;
    border-bottom: 1px solid #395132;
}

QTableView {
    background-color: #263621;
    alternate-background-color: #223020;
    border: 1px solid #395132;
    border-radius: 8px;
    font-size: 11px;
    outline: none;
    gridline-color: transparent;
    selection-background-color: #807641;
    selection-color: #171f14;
}
QTableView::item {
    padding: 4px 8px;
    border: none;
}
QTableView::item:selected {
    background-color: #807641;
    color: #171f14;
}
QTableView::item:hover {
    background-color: #2e4226;
}
/* QLineEdit */
QLineEdit {
    border: 2px solid #2e4226;
    border-radius: 4px;
    background-color: #182315;
    color: #c9c9c9;
    font-size: 11px;
    padding: 4px 8px;
    selection-background-color: #807641;
    selection-color: #171f14;
}
QLineEdit:hover {
    background-color: #1d2719;
    border: 2px solid #395132;
}
QLineEdit:focus {
    border: 2px solid #c9a961;
    background-color: #1d2719;
}
QLineEdit:disabled {
    background-color: #141d10;
    color: #5a6a52;
}
/* QPushButton */
QPushButton#altButton {
    background-color: #263621;
    border: 1px solid #395132;
    border-radius: 4px;
    padding: 4px 8px;
}
QPushButton#altButton:hover {
    background-color: #163621;
    border: 1px solid #c9a961;
}
QPushButton#altButton:pressed {
    background-color: #131f0f;
    border: 1px solid #c9a961;
}
QPushButton#altButton:disabled {
    background-color: #1b241a;
    border: 1px solid #2a352a;
}

/* Filter Menu */
QWidget#filterMenu {
    background-color: #263621;
    border: 1px solid #395132;
    border-radius: 6px;
}

QWidget#filterMenu QLabel {
    color: #8fa384;
    font-size: 8px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

QWidget#filterMenu QComboBox {
    background-color: #1e2b1a;
    border: 1px solid #395132;
    border-radius: 4px;
    padding: 4px 8px;
    color: #c9c9c9;
}
QWidget#filterMenu QComboBox:hover {
    border: 1px solid #c9a961;
}
QWidget#filterMenu QComboBox::drop-down {
    border: none;
    width: 20px;
}

QAbstractItemView#filterMenuList {
    background-color: #263621;
    border: 1px solid #395132;
    border-radius: 4px;
    outline: none;
    padding: 2px;
}
QAbstractItemView#filterMenuList::item {
    padding: 4px 8px;
    border-radius: 3px;
}
QAbstractItemView#filterMenuList::item:selected {
    background-color: #807641;
    color: #171f14;
}