<RCC>
    <qresource prefix="/fonts">
        <file alias="Roboto-Bold.ttf">assets/fonts/Roboto-Bold.ttf</file>
        <file alias="Roboto-Light.ttf">assets/fonts/Roboto-Light.ttf</file>
        <file alias="Roboto-Regular.ttf">assets/fonts/Roboto-Regular.ttf</file>
        <file alias="Roboto-Medium.ttf">assets/fonts/Roboto-Medium.ttf</file>
        <file alias="Roboto-SemiBold.ttf">assets/fonts/Roboto-SemiBold.ttf</file>
    </qresource>
    <qresource prefix="/icons">
        <file alias="path.svg">assets/icons/escalator.svg</file>
        <file alias="filter.svg">assets/icons/filter.svg</file>
        <file alias="coin.svg">assets/icons/coin.svg</file>
        <file alias="fence.svg">assets/icons/fence.svg</file>
        <file alias="building.svg">assets/icons/home.svg</file>
        <file alias="id.svg">assets/icons/id.svg</file>
        <file alias="fountain.svg">assets/icons/fountain.svg</file>
        <file alias="paw.svg">assets/icons/paw.svg</file>
        <file alias="music.svg">assets/icons/playlist.svg</file>
        <file alias="tree.svg">assets/icons/tree.svg</file>
    </qresource>
</RCC>
